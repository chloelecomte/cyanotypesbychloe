# Copy to .env.local for `npm run dev`. Use the DEV Supabase project's values, never prod.
# Supabase dashboard → Project Settings → API Keys (the publishable key, sb_publishable_…;
# a legacy "anon" key also works here).
NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
